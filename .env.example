# Copie ce fichier en .env puis remplis les valeurs.
# Clé Groq : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Modèle Ollama de secours (doit savoir appeler des outils, ex. qwen3:8b)
OLLAMA_MODEL=qwen3:8b
# Identifiants de l'API Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Chemin de ton CV en PDF
CV_PATH=data/cv.pdf
